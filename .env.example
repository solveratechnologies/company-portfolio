# ---------------------------------------------------------------
# Solvera Technologies — environment variables
# Copy to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------

# Public site origin: the ONE authoritative URL used for canonical links, sitemap.xml, robots.txt,
# Open Graph and JSON-LD. Origin only (no path), e.g. https://www.your-domain.com
# - REQUIRED for production builds: `next build` fails with an explicit error if it is empty or not https.
# - Optional in development: falls back to http://localhost:3000.
# - Inlined at BUILD time, so it must be set in the build environment, not only on the running server.
NEXT_PUBLIC_SITE_URL=

# Content source. "static" uses the files in src/data. "dynamic" loads JSON from CONTENT_API_URL.
# Switching this one value changes every page. Pages stay server-rendered either way.
CONTENT_MODE=static
# Full URL of the content endpoint, required when CONTENT_MODE=dynamic.
# Expected JSON keys (each optional; omitted keys keep the static copy):
# services, projects, articles, industries, testimonials, processPhases, detailedPhases, faqGroups, contactFaqs
CONTENT_API_URL=
# Optional bearer token sent with the content request.
CONTENT_API_TOKEN=

# Hide sections without editing page files. Comma-separated page:section pairs.
# Example: home:testimonials,home:insights,about:process
# Section ids live in src/config/sections.ts. Setting a flag there to false also hides it.
HIDDEN_SECTIONS=

# Verified public contact details. Leave empty to hide them everywhere.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Verified social profiles, comma-separated "Label|https://url" pairs. Leave empty to hide.
# The footer shows icons for the labels X (or Twitter), Facebook, Instagram and LinkedIn; other labels show as text.
# Example: X|https://x.com/you,Facebook|https://www.facebook.com/you,Instagram|https://www.instagram.com/you,LinkedIn|https://www.linkedin.com/company/you
NEXT_PUBLIC_SOCIAL_LINKS=

# --- Contact page: booking calendar or inquiry form ---
# Which block the Contact page shows (server-side only):
#   booking = date-picker booking calendar: choose a date, then name, email and company (default)
#   form    = the project inquiry form
# Only the selected one is shown. Empty or unknown values mean "booking". Read when the page is built/rendered, so restart
# `npm run dev` (or rebuild) after changing it. Booking requests are delivered with the SAME settings as the form below.
CONTACT_MODE=booking

# --- Contact form delivery (configure ONE option; server-side only) ---
# (Used by both the inquiry form and the booking calendar.)

# Option A: Resend email API (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional. Comma-separated addresses that get a CC copy of every inquiry and booking email
# (Resend and SMTP only; not used by the webhook).
CONTACT_CC_EMAIL=
# Must be an address on a domain verified in Resend, e.g. "Solvera Website <website@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Option B: SMTP through nodemailer (works with a free Gmail account). Uses CONTACT_TO_EMAIL above
# as the inbox that receives inquiries. Server-side only: NEVER prefix these with NEXT_PUBLIC_.
# Gmail setup: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 characters (no spaces) below.
# Do not use your normal Google password. Gmail always sends as the signed-in account.
# SMTP_USER is the full Gmail address that signs in.
SMTP_USER=
SMTP_PASS=
# Optional. Defaults: smtp.gmail.com and 465 (TLS). Port 587 uses STARTTLS. Other providers: set both.
SMTP_HOST=
SMTP_PORT=
# If CONTACT_FROM_EMAIL (above) is empty, SMTP_USER is used as the From address.

# Option C: Webhook (n8n, Make, Zapier, GoHighLevel inbound webhook, or your own CRM endpoint)
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
CONTACT_WEBHOOK_SECRET=
# The webhook URL must be https (http is accepted only for localhost test receivers).
# A 2xx response is the only thing treated as "accepted"; redirects are not followed.

# --- Contact form abuse protection (server-side only) ---

# Name of the request header that YOUR reverse proxy / CDN sets (and overwrites) with the real client IP,
# e.g. cf-connecting-ip, x-real-ip, x-vercel-forwarded-for, or x-forwarded-for (right-most entry is used).
# Leave empty if unsure: client-supplied X-Forwarded-For is then ignored and all visitors share one
# flood-protection bucket (cannot be spoofed, but less precise). Rate limits are per server instance
# unless you register a shared store with setRateLimitStore() (see README).
CONTACT_CLIENT_IP_HEADER=

# Set to "true" to send the Content-Security-Policy as report-only while evaluating a change.
CSP_REPORT_ONLY=

# --- Legal pages (privacy policy, terms, cookie policy) ---
# The owner's facts and per-page review status are recorded in src/config/legal.ts, so none of these are
# needed in production. Set one ONLY to override the recorded value (server-side, build time).
# Each page has its own gate: it stays noindex, is left out of sitemap.xml and shows a "template" notice
# until the facts it needs are present and it has been reviewed.
LEGAL_ENTITY_NAME=
LEGAL_REGISTERED_ADDRESS=
# Governing law and the city/country of the courts for website-use disputes (Terms).
LEGAL_JURISDICTION=
LEGAL_COURTS_LOCATION=
LEGAL_EFFECTIVE_DATE=
LEGAL_LAST_UPDATED=
LEGAL_PRIVACY_EMAIL=
# Retention periods shown in the privacy policy's retention table.
LEGAL_RETENTION_INQUIRIES=
LEGAL_RETENTION_CLIENTS=
LEGAL_RETENTION_MARKETING=
LEGAL_RETENTION_ANALYTICS=
LEGAL_RETENTION_RECRUITMENT=
LEGAL_RETENTION_PROSPECTS=
LEGAL_RETENTION_LOGS=
LEGAL_RETENTION_RECORDINGS=
# Primary operating country, and statements of actual practice shown in Sections 15, 16 and 22.
LEGAL_PRIMARY_COUNTRY=
LEGAL_ADVERTISING_STATEMENT=
LEGAL_SALE_SHARING_STATEMENT=
LEGAL_SENSITIVE_STATEMENT=
# Optional lines in the privacy policy; left out when empty.
LEGAL_PHONE=
LEGAL_EU_REPRESENTATIVE=
LEGAL_UK_REPRESENTATIVE=
LEGAL_DPO=
# Set to "true" to mark EVERY legal page as reviewed by qualified counsel (normally recorded per page in code).
LEGAL_COUNSEL_REVIEWED=
